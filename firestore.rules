rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pedidos/{id} {
      // Cliente cria o pedido e acompanha pelo código (id difícil de adivinhar)
      allow create: if request.resource.data.status == 'novo'
                    && request.resource.data.total is number
                    && request.resource.data.itens is list;
      allow get: if true;
      // Somente a loja (logada) lista, altera e apaga
      allow list, update, delete: if request.auth != null;
    }
    // Loja aberta/fechada: todos leem, só a loja altera
    match /config/{doc} {
      allow get: if true;
      allow write: if request.auth != null;
    }
  }
}
